# Copy this file to .env (in this same HR_skill/ folder) and fill in real values.
# .env is gitignored — never commit real tokens.

# Jira account for this HR user (personal logtime + company-wide lookups)
JIRA_DOMAIN=torilab-ai.atlassian.net
JIRA_EMAIL=your-email@torilab.ai
JIRA_API_TOKEN=

# Slack user token — needed for personal logtime's absence detection, and
# for missing_logtime's scan/notify. Needs the `users:read.email` scope for
# missing_logtime's Slack->Jira identity resolution to work.
SLACK_USER_TOKEN=

# Tempo API token — needed for export_report.js and missing_logtime.js
# (both discover company-wide worklogs straight from Tempo, no roster).
# Generate at: Jira -> Apps -> Tempo -> Settings -> API Integration
TEMPO_API_TOKEN=

# Google auth for export_report.js (writes into the copied monthly report's
# "Jira log"/"Jira absence"/"Jira OT" tabs) — acts as a real Google account
# via OAuth, so no file/folder sharing is needed. Create an OAuth Client ID
# of type "Desktop app" in a GCP project, set the two vars below, then run
# `node scripts/google_login.js` once to fill in GOOGLE_OAUTH_REFRESH_TOKEN
# automatically.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
